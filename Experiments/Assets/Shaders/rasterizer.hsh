#ifndef RASTERIZER_HSH
#define RASTERIZER_HSH

struct NDCTri
{
    float4 Verts[3];
    uint TriangleIndex;
};

static uint const RasterBatchSize = 16;
struct RasterBatch
{
    uint TriangleIndices[RasterBatchSize];
    uint TriangleCount;
    vk::BufferPointer<RasterBatch> Next;
};

#endif // RASTERIZER_HSH